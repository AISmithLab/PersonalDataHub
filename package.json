{
  "name": "personaldatahub",
  "version": "0.1.0",
  "description": "Centralized access control layer for personal data",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "main": "dist/index.js",
  "bin": {
    "pdh": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build-frontend.mjs && npm run build:frontend-next && tsc && chmod +x dist/cli.js",
    "build:frontend-next": "vite build --config src/gateway/gui/frontend-web/vite.config.ts && node scripts/generate-frontend.mjs",
    "dev": "node scripts/build-frontend.mjs && npm run build:frontend-next && tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "setup": "node dist/cli.js init",
    "build:lambda": "esbuild src/lambda.ts src/lambda-seed.ts --bundle --platform=node --target=node22 --outdir=dist-lambda --format=esm --external:better-sqlite3 --external:@aws-sdk/* --minify --tree-shaking=true",
    "build:mobile": "npm run build && node scripts/bundle-mobile.cjs"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.25.0",
    "nativewind": "^4.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@hono/node-server": "^1.19.9",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bcryptjs": "^3.0.3",
    "googleapis": "^171.4.0",
    "hono": "^4.12.1",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "openai": "^6.38.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-svg": "^15.11.2",
    "react-native-web": "^0.20.0",
    "sql.js": "^1.12.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "allowScripts": {
    "nodejs-mobile-react-native@18.20.4": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true
  }
}
